/** Generator which produces TypeScript type definitions (one file per class / enum / xenum).
 * It is only called if enabled in the preferences (-Dbonaparte.TypeScript=true).
 *
 * Wire-format rules (verified against a live bonaparte server):
 * - Plain (non-alpha) enums are serialized as numeric ordinals
 * - Alpha enums are serialized as their token strings
 * - `instant` is serialized as epoch seconds (number)
 * - `day`, `time`, `timestamp` are serialized as strings
 * - `enumset` (numeric index) is serialized as an integer bitmap
 * - `xenumset` is serialized as a string
 * - JSON binary fields use Base64 strings; JSON map keys are strings, with integer / long keys prefixed by `_`
 * - Tokenizable enum and xenum JSON values use tokens; non-tokenizable enums use numeric ordinals by default
 * - Every object carries a `'@PQON'` field with the partially qualified object name
 * - List elements may be null (fixed-size lists contain nulls)
 * - Plain `Object` / `Element` map to `BonaPortable`
 *
 * Dependencies:
 * TypeScriptBonScriptGeneratorMain ..> TsModuleResolver : resolves modules and paths
 * TypeScriptBonScriptGeneratorMain ..> TsImportCollector : collects type references
 * TypeScriptBonScriptGeneratorMain ..> TsModuleExportNames : assigns barrel export names
 */
class TypeScriptBonScriptGeneratorMain extends AbstractGenerator {
    public static final String GENERATED_TS_SUBFOLDER = "ts/"
// cannot start with a slash, must end with a slash
    public static final String GENERATED_COMMENT = "// autogenerated by bonaparte DSL. Do not modify, changes will be lost."

    override void doGenerate(Resource resource, IFileSystemAccess2 fsa, IGeneratorContext unused) {
        if (TsModuleResolver.isCurrentModule(resource)) {
            val modules = resource.resourceSet.resources.filter[
                TsModuleResolver.isCurrentModule(it) || TsModuleResolver.isIncludedModule(it)].toList
            for (source : modules) {
                for (e : source.allContents.toIterable.filter(typeof(EnumDefinition)))
                    fsa.generateFile(e.tsFilename(e.name), e.writeEnum)
                for (e : source.allContents.toIterable.filter(typeof(XEnumDefinition)))
                    fsa.generateFile(e.tsFilename(e.name), e.writeXEnum)
                for (e : source.allContents.toIterable.filter(typeof(EnumSetDefinition)))
                    fsa.generateFile(e.tsFilename(e.name), e.writeEnumSet)
                for (e : source.allContents.toIterable.filter(typeof(XEnumSetDefinition)))
                    fsa.generateFile(e.tsFilename(e.name), e.writeXEnumSet)
                for (c : source.allContents.toIterable.filter(typeof(ClassDefinition)))
                    fsa.generateFile(c.tsFilename(c.name), c.writeInterface)
                val folder = TsModuleResolver.outputFolder(source)
                if (TsModuleResolver.generatesPortableSupport(source)) {
                    fsa.generateFile(folder + "bona-portable.ts", bonaPortableSource)
                    fsa.generateFile(folder + TsMetaRuntimeSource.MODULE_NAME + ".ts",
                        GENERATED_COMMENT + "\n\n" + TsMetaRuntimeSource.source)
                }
                fsa.generateFile(folder + "package.json", entryPointPackageJson)
                fsa.generateFile(folder + "ng-package.json", entryPointNgPackageJson)
                fsa.generateFile(folder + "index.ts", writeModuleIndex(modules, source))
                fsa.generateFile(folder + "api-index.ts", GENERATED_COMMENT + "\nexport {};\n")
            }
        }
    }

    def private static CharSequence bonaPortableSource() {
        '''
        «GENERATED_COMMENT»
        export interface BonaPortable {
            '@PQON': string;
            [key: string]: unknown;
        }
        '''
    }

    def private static CharSequence entryPointPackageJson() {
        '''{
          "ngPackage": {
            "lib": {
              "entryFile": "index.ts"
            }
          }
        }
        '''
    }

    def private static CharSequence entryPointNgPackageJson() {
        '''{
            "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
            "lib": {
                "entryFile": "index.ts"
            }
        }
        '''
    }

    def private static CharSequence writeModuleIndex(Iterable<Resource> resources, Resource module) {
        val out = new StringBuilder
        val typesByIdentity = new LinkedHashMap<String, EObject>
        out.append(GENERATED_COMMENT).append("\n\n")
        if (TsModuleResolver.generatesPortableSupport(module)) {
            out.append("export type { BonaPortable } from './bona-portable';\n")
            out.append("export type { BonaProps, TsFieldMeta, TsClassMeta, BonValidationRule, BonValidationIssue }"
                + " from './" + TsMetaRuntimeSource.MODULE_NAME + "';\n")
            out.append("export { bonAllFields, bonClassProp, bonValidate } from './"
                + TsMetaRuntimeSource.MODULE_NAME + "';\n")
        }
        for (source : resources.filter[TsModuleResolver.isSameModule(it, module)]) {
            for (type : source.allContents.toIterable.filter(typeof(EnumDefinition)))
                typesByIdentity.putIfAbsent(TsImportCollector.bonIdentity(type), type)
            for (type : source.allContents.toIterable.filter(typeof(XEnumDefinition)))
                typesByIdentity.putIfAbsent(TsImportCollector.bonIdentity(type), type)
            for (type : source.allContents.toIterable.filter(typeof(EnumSetDefinition)))
                typesByIdentity.putIfAbsent(TsImportCollector.bonIdentity(type), type)
            for (type : source.allContents.toIterable.filter(typeof(XEnumSetDefinition)))
                typesByIdentity.putIfAbsent(TsImportCollector.bonIdentity(type), type)
            for (type : source.allContents.toIterable.filter(typeof(ClassDefinition)))
                typesByIdentity.putIfAbsent(TsImportCollector.bonIdentity(type), type)
        }

        val types = new ArrayList<EObject>(typesByIdentity.values)
        val exportNames = new TsModuleExportNames(types)
        for (type : types) {
            val name = TsImportCollector.simpleName(type)
            val exportName = exportNames.exportName(type)
            val modulePath = "./" + TsModuleResolver.packagePath(type) + "/" + name
            if (type instanceof EnumDefinition) {
                out.append("export { ").append(name)
                if (exportName != name)
                    out.append(" as ").append(exportName)
                out.append(" } from '").append(modulePath).append("';\n")
            } else if (type instanceof XEnumDefinition || type instanceof EnumSetDefinition
                    || type instanceof XEnumSetDefinition) {
                out.append("export type { ").append(name)
                if (exportName != name)
                    out.append(" as ").append(exportName)
                out.append(" } from '").append(modulePath).append("';\n")
            } else if (type instanceof ClassDefinition) {
                val c = type as ClassDefinition
                out.append("export { ").append(name).append("PQON")
                if (exportName != name)
                    out.append(" as ").append(exportName).append("PQON")
                out.append(" } from '").append(modulePath).append("';\n")
                out.append("export { ").append(name).append("Meta")
                if (exportName != name)
                    out.append(" as ").append(exportName).append("Meta")
                out.append(" } from '").append(modulePath).append("';\n")
                out.append("export type { ").append(name)
                if (exportName != name)
                    out.append(" as ").append(exportName)
                out.append(" } from '").append(modulePath).append("';\n")
                if (c.extendsClass !== null && c.extendsClass.classRef !== null
                        && !TsModuleResolver.isSameModule(c, c.extendsClass.classRef)) {
                    out.append("export { is").append(name)
                    if (exportName != name)
                        out.append(" as is").append(exportName)
                    out.append(" } from '").append(modulePath).append("';\n")
                }
            }
        }
        out.append("export * from './api-index';\n")
        out
    }

    def private static String tsFilename(EObject d, String name) {
        TsModuleResolver.generatedFile(d, name)
    }

    def private static CharSequence writeImports(EObject from, String fromTypeName, TsImportCollector refs) {
        val out = new StringBuilder
        for (type : refs.types) {
            val name = TsImportCollector.simpleName(type)
            if (from !== type) {
                val importedName = TsModuleResolver.importedTypeName(from, type)
                out.append("import type { ").append(importedName)
                if (importedName != name)
                    out.append(" as ").append(name)
                out.append(" } from \"")
                    .append(TsModuleResolver.importPath(from, fromTypeName, type, name)).append("\";\n")
            }
        }
        out
    }

    def private static CharSequence writeMetaImports(EObject from, String fromTypeName, TsImportCollector refs) {
        val out = new StringBuilder
        for (type : refs.types) {
            val name = TsImportCollector.simpleName(type)
            if (from !== type) {
                val importedName = TsModuleResolver.importedTypeName(from, type)
                out.append("import { ").append(importedName).append("Meta")
                if (importedName != name)
                    out.append(" as ").append(name).append("Meta")
                out.append(" } from \"")
                    .append(TsModuleResolver.importPath(from, fromTypeName, type, name)).append("\";\n")
            }
        }
        out
    }

    def private static CharSequence jsdoc(String text) {
        if (text === null)
            return ""
        // strip the comment delimiters of the bonaparte javadoc comment
        val body = text.replaceFirst("^/\\*\\*", "").replaceFirst("\\*/$", "").trim
        return '''
            /** «body.replace("*/", "* /")» */
        '''
    }

    /** Deprecated marker for classes, enums, fields, packages. */
    def private static CharSequence deprecatedMarker(EObject d) {
        val isDep = if (d instanceof ClassDefinition) d.isDeprecated
                    else if (d instanceof EnumDefinition) d.isDeprecated
                    else if (d instanceof XEnumDefinition) d.isDeprecated
                    else if (d instanceof FieldDefinition) d.isDeprecated
                    else false
        val hasBonPackage = d instanceof ClassDefinition || d instanceof EnumDefinition || d instanceof XEnumDefinition
            || d instanceof EnumSetDefinition || d instanceof XEnumSetDefinition
        val isPackageDeprecated = hasBonPackage && (d.eContainer as PackageDefinition).isDeprecated
        if (isDep || isPackageDeprecated)
            return "/** @deprecated */\n"
        return ""
    }

    def private static CharSequence writeEnum(EnumDefinition d) {
        val alpha = JavaEnum.isAlphaEnum(d)
        '''
            «GENERATED_COMMENT»

            «d.javadoc.jsdoc»
            «d.deprecatedMarker»
            «IF alpha»
                export const «d.name» = {
                    «FOR v : d.avalues SEPARATOR ","»
                        «v.name»: "«v.token»"
                    «ENDFOR»
                } as const;
                export type «d.name» = (typeof «d.name»)[keyof typeof «d.name»];
            «ELSE»
                export const «d.name» = {
                    «FOR v : d.values SEPARATOR ","»
                        «v»: «d.values.indexOf(v)»
                    «ENDFOR»
                } as const;
                export type «d.name» = (typeof «d.name»)[keyof typeof «d.name»];
            «ENDIF»
        '''
    }

    def private static CharSequence writeXEnum(XEnumDefinition d) {
        '''
            «GENERATED_COMMENT»

            «d.javadoc.jsdoc»
            «d.deprecatedMarker»
            export type «d.name» = string;
        '''
    }

    def private static CharSequence writeEnumSet(EnumSetDefinition d) {
        val indexType = d.indexType
        val bitmapType = if (indexType !== null && indexType.toLowerCase.startsWith("s")) "string" else "number"
        val brand = d.name + "Brand"
        '''
            «GENERATED_COMMENT»

            «d.javadoc.jsdoc»
            «d.deprecatedMarker»
            declare const «brand»: unique symbol;
            export type «d.name» = «bitmapType» & { readonly [«brand»]: "«TsModuleResolver.pqon(d)»" };
        '''
    }

    def private static CharSequence writeXEnumSet(XEnumSetDefinition d) {
        val brand = d.name + "Brand"
        '''
            «GENERATED_COMMENT»

            «d.javadoc.jsdoc»
            «d.deprecatedMarker»
            declare const «brand»: unique symbol;
            export type «d.name» = string & { readonly [«brand»]: { set: "«TsModuleResolver.pqon(d)»", xenum: "«TsModuleResolver.pqon(d.myXEnum)»" } };
        '''
    }

    def private static CharSequence writeInterface(ClassDefinition d) {
        val refs = new TsImportCollector
        val metaRefs = new TsImportCollector
        val generics = if (!d.genericParameters.empty) '''<«FOR g : d.genericParameters SEPARATOR ", "»«g.name» = unknown«ENDFOR»>'''
        val parent = if (d.extendsClass !== null)
            " extends Omit<" + d.extendsClass.tsClassRef(d, refs) + ", '@PQON'>"
        val guard = d.typeGuard
        val pqon = TsModuleResolver.pqon(d)
        val body = '''
            «FOR f : d.fields»
                «f.javadoc.jsdoc»
                «f.deprecatedMarker»
                «f.tsFieldMetadata»
                «f.name»«IF !f.cannotBeNull»?«ENDIF»: «f.tsFieldType(d, refs)»;
            «ENDFOR»
            '@PQON': typeof «d.name»PQON;
        '''
        val meta = d.tsClassMeta(metaRefs)
        return '''
            «GENERATED_COMMENT»
            import type { BonaPortable } from "«TsModuleResolver.runtimeSupportImport(d, d.name, "bona-portable")»";
            import type { TsClassMeta } from "«TsModuleResolver.runtimeSupportImport(d, d.name, TsMetaRuntimeSource.MODULE_NAME)»";
            «d.writeImports(d.name, refs)»
            «d.writeMetaImports(d.name, metaRefs)»

            export const «d.name»PQON = "«pqon»" as const;
            «d.javadoc.jsdoc»
            «d.deprecatedMarker»
            export interface «d.name»«generics»«parent» {
                «body»
            }
            «guard»

            «meta»
        '''
    }
    def private static CharSequence tsFieldMetadata(FieldDefinition f) {
        val tags = new ArrayList<String>
        val ref = DataTypeExtension.get(f.datatype)
        tags.add("@bonaparte.required " + f.cannotBeNull)
        if (f.defaultString !== null) {
            val defaultValue = if (ref.javaType.equals("String")) f.defaultString.tsJSDocString
                               else f.defaultString.commentSafe
            tags.add("@bonaparte.default " + defaultValue)
        }
        else if (ref.effectiveEnumDefault) {
            val elem = ref.elementaryDataType
            val enumType = if (elem.enumType !== null) elem.enumType
                           else if (elem.xenumType !== null) elem.xenumType.myEnum
                           else null
            if (enumType !== null && ref.enumMaxTokenLength == DataTypeExtension.ENUM_NUMERIC)
                tags.add("@bonaparte.default 0")
            else if (enumType !== null && !enumType.avalues.empty)
                tags.add("@bonaparte.default " + enumType.avalues.head.token.tsJSDocString)
            else
                tags.add("@bonaparte.default first-defined-enum-value")
        }
        if (f.isArray !== null)
            f.addAggregateMetadata(tags, "array", f.isArray.mincount, f.isArray.maxcount)
        else if (f.isList !== null)
            f.addAggregateMetadata(tags, "list", f.isList.mincount, f.isList.maxcount)
        else if (f.isSet !== null)
            f.addAggregateMetadata(tags, "set", f.isSet.mincount, f.isSet.maxcount)
        else if (f.isMap !== null) {
            f.addAggregateMetadata(tags, "map", f.isMap.mincount, f.isMap.maxcount)
            tags.add("@bonaparte.mapKey " + f.isMap.indexType.toLowerCase)
            tags.add("@bonaparte.jsonMapKeyFormat "
                + (if (f.isMap.indexType.equals("String")) "identity" else "underscore-prefixed-decimal"))
        }
        val elem = ref.elementaryDataType
        if (elem !== null) {
            if (elem.enumType !== null)
                tags.add("@bonaparte.wireFormat "
                    + (if (ref.enumMaxTokenLength == DataTypeExtension.ENUM_NUMERIC)
                        "numeric-enum-ordinal" else "enum-token-string"))
            if (elem.xenumType !== null)
                tags.add("@bonaparte.wireFormat enum-token-string")
            if (elem.enumsetType !== null)
                tags.add("@bonaparte.wireFormat "
                    + (if ("String".equals(elem.enumsetType.indexType))
                        "string-enum-bitmap" else "numeric-enum-bitmap"))
            if (elem.xenumsetType !== null)
                tags.add("@bonaparte.wireFormat string-enum-bitmap")
            switch elem.name.toLowerCase {
                case "instant": tags.add("@bonaparte.wireFormat epoch-seconds")
                case "day", case "time", case "timestamp": tags.add("@bonaparte.wireFormat iso-8601-string")
            }
            if (ref.category == DataCategory.BINARY) {
                tags.add("@bonaparte.encoding base64")
                if (elem.length > 0)
                    tags.add("@bonaparte.maxBytes " + elem.length)
            }
            if (ref.javaType.equals("String")) {
                if (elem.minLength > 0)
                    tags.add("@bonaparte.minLength " + elem.minLength)
                if (elem.length > 0)
                    tags.add("@bonaparte.maxLength " + elem.length)
                if (elem.regexp !== null)
                    tags.add("@bonaparte.pattern " + elem.regexp.tsJSDocString)
                if (elem.name.equalsIgnoreCase("uppercase"))
                    tags.add("@bonaparte.case uppercase")
                else if (elem.name.equalsIgnoreCase("lowercase"))
                    tags.add("@bonaparte.case lowercase")
            }
            if (elem.length > 0 && (ref.category == DataCategory.NUMERIC
                    || ref.category == DataCategory.BASICNUMERIC)) {
                tags.add("@bonaparte.precision " + elem.length)
                tags.add("@bonaparte.scale " + elem.decimals)
            }
        }
        for (property : f.properties)
            tags.add("@bonaparte.property " + property.key.name
                + (if (property.value === null) "" else "=" + property.value.tsJSDocString))
        if (tags.empty)
            return ""
        return "/**\n * " + tags.join("\n * ") + "\n */\n"
    }

    private static def void addAggregateMetadata(FieldDefinition f, List<String> tags,
            String kind, int minCount, int maxCount) {
        tags.add("@bonaparte.aggregate " + kind + (if (f.cannotBeNull) " required" else " optional"))
        if (minCount > 0)
            tags.add("@bonaparte.minCount " + minCount)
        if (maxCount > 0)
            tags.add("@bonaparte.maxCount " + maxCount)
    }

    private static def String commentSafe(String value) {
        value.replace("*/", "* /").replace("\r", " ").replace("\n", " ")
    }

    private static def String tsJSDocString(String value) {
        "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").commentSafe + "\""
    }

    private static def String tsStringLiteral(String value) {
        "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r") + "\""
    }

    /** Object literal with all properties; a property without value becomes true. */
    private static def String tsProps(Iterable<PropertyUse> properties) {
        val literals = new LinkedHashMap<String, String>
        for (property : properties)
            literals.put(property.key.name.tsStringLiteral,
                if (property.value === null) "true" else property.value.tsStringLiteral)
        if (literals.empty)
            return "{}"
        return "{ " + literals.entrySet.map[key + ": " + value].join(", ") + " }"
    }

    private static def String metaIdentifier(ClassDefinition target, TsImportCollector metaRefs) {
        metaRefs.add(target)
        target.name + "Meta"
    }

    private static def String tsDefaultValue(FieldDefinition f, DataTypeExtension ref) {
        if (f.defaultString !== null)
            return f.defaultString
        if (ref.effectiveEnumDefault) {
            val elem = ref.elementaryDataType
            val enumType = if (elem.enumType !== null) elem.enumType
                           else if (elem.xenumType !== null) elem.xenumType.myEnum
                           else null
            if (enumType !== null && ref.enumMaxTokenLength == DataTypeExtension.ENUM_NUMERIC)
                return "0"
            if (enumType !== null && !enumType.avalues.empty)
                return enumType.avalues.head.token
        }
        return null
    }

    /** Runtime metadata of a class: its own fields, class properties and lazy references to the parent and related classes. */
    def private static CharSequence tsClassMeta(ClassDefinition d, TsImportCollector metaRefs) {
        val parentRef = d.extendsClass
        val parentClass = if (parentRef !== null && !parentRef.plainObject) parentRef.classRef else null
        val propsInherited = parentClass !== null && (d.inheritProperties || d.package.inheritProperties)
        return '''
            export const «d.name»Meta: TsClassMeta = {
                pqon: «d.name»PQON,
                «IF parentClass !== null»
                    parent: () => «parentClass.metaIdentifier(metaRefs)»,
                «ENDIF»
                props: «d.properties.tsProps»,
                propsInherited: «propsInherited»,
                own: {
                    «FOR f : d.fields»
                        «f.name.tsStringLiteral»: «f.tsFieldMeta(metaRefs)»,
                    «ENDFOR»
                },
            };
        '''
    }

    private static def String tsFieldMeta(FieldDefinition f, TsImportCollector metaRefs) {
        val entries = new ArrayList<String>
        val ref = DataTypeExtension.get(f.datatype)
        entries.add("required: " + f.cannotBeNull)
        val defaultValue = f.tsDefaultValue(ref)
        if (defaultValue !== null)
            entries.add("default: " + defaultValue.tsStringLiteral)
        val elem = ref.elementaryDataType
        if (elem !== null) {
            if (ref.category == DataCategory.BINARY && elem.length > 0)
                entries.add("maxBytes: " + elem.length)
            if (ref.javaType.equals("String")) {
                if (elem.minLength > 0)
                    entries.add("minLength: " + elem.minLength)
                if (elem.length > 0)
                    entries.add("maxLength: " + elem.length)
                if (elem.regexp !== null)
                    entries.add("pattern: " + elem.regexp.tsStringLiteral)
                if (elem.name.equalsIgnoreCase("uppercase"))
                    entries.add("case: \"uppercase\"")
                else if (elem.name.equalsIgnoreCase("lowercase"))
                    entries.add("case: \"lowercase\"")
            }
            if (elem.length > 0 && (ref.category == DataCategory.NUMERIC
                    || ref.category == DataCategory.BASICNUMERIC)) {
                entries.add("precision: " + elem.length)
                entries.add("scale: " + elem.decimals)
            }
        }
        if (f.isArray !== null)
            entries.addAggregateMeta("array", f.isArray.mincount, f.isArray.maxcount)
        else if (f.isList !== null)
            entries.addAggregateMeta("list", f.isList.mincount, f.isList.maxcount)
        else if (f.isSet !== null)
            entries.addAggregateMeta("set", f.isSet.mincount, f.isSet.maxcount)
        else if (f.isMap !== null)
            entries.addAggregateMeta("map", f.isMap.mincount, f.isMap.maxcount)
        entries.add("props: " + f.properties.tsProps)
        // genericsRef holds the declared class reference of every object field, not only of generics
        val objectRef = ref.genericsRef
        if (objectRef !== null && !objectRef.plainObject && objectRef.genericsParameterRef === null
                && objectRef.classRef !== null) {
            entries.add("objectType: () => " + objectRef.classRef.metaIdentifier(metaRefs))
            if (f.properties.exists[key.name == "ref"] && ref.secondaryObjectDataType !== null)
                entries.add("refTarget: () => " + ref.secondaryObjectDataType.metaIdentifier(metaRefs))
        }
        return "{ " + entries.join(", ") + " }"
    }

    private static def void addAggregateMeta(List<String> entries, String kind, int minCount, int maxCount) {
        val parts = new ArrayList<String>
        parts.add("kind: \"" + kind + "\"")
        if (minCount > 0)
            parts.add("minCount: " + minCount)
        if (maxCount > 0)
            parts.add("maxCount: " + maxCount)
        entries.add("aggregate: { " + parts.join(", ") + " }")
    }

    def private static CharSequence typeGuard(ClassDefinition d) {
        val parent = d.extendsClass
        if (parent === null || parent.plainObject || parent.classRef === null
                || TsModuleResolver.isSameModule(d, parent.classRef))
            return ""
        return TsModuleResolver.typeGuard(d.name, d.package.name + "." + d.name)
    }

    /** Type of a field, including aggregate and null handling. */
    def private static String tsFieldType(FieldDefinition f, ClassDefinition owner, TsImportCollector refs) {
        val base = f.datatype.tsBaseType(owner, refs)
        val isCollection = f.isArray !== null || f.isList !== null || f.isSet !== null
        // list elements may be null (fixed-size lists contain nulls);
        // an optional scalar field may contain null at runtime
        val elem = if (isCollection) base + " | null"
                   else if (!f.cannotBeNull && f.isAggregateScalar) base + " | null" else base
        if (isCollection)
            return (if (elem.contains(" ")) "(" + elem + ")" else elem) + "[]"
        if (f.isMap !== null)
            return "Record<string, " + elem + ">"
        return elem
    }

    // optional scalar fields are "T | null" (a missing field is expressed by the "?")
    def private static boolean isAggregateScalar(FieldDefinition f) {
        f.isArray === null && f.isList === null && f.isSet === null && f.isMap === null
    }

    def private static String tsClassRef(ClassReference r, EObject from, TsImportCollector refs) {
        if (r.plainObject)
            return "BonaPortable"
        if (r.genericsParameterRef !== null)
            return r.genericsParameterRef.name
        val cls = r.classRef
        if (cls === null)
            return "BonaPortable"
        refs.add(cls)
        if (r.classRefGenericParms.empty)
            return cls.name
        return cls.name + "<" + r.classRefGenericParms.map[tsClassRef(from, refs)].join(", ") + ">"
    }

    /** Maps the (typedef resolved) data type of a field to a TypeScript type, collecting the types to be imported. */
    def private static String tsBaseType(DataType dt, ClassDefinition owner, TsImportCollector refs) {
        val ref = DataTypeExtension.get(dt)
        if (ref.genericsRef !== null)
            return ref.genericsRef.tsFieldClassRef(owner, refs)
        if (ref.objectDataType !== null) {
            if (ref.objectDataType instanceof ClassDefinition) {
                val polymorphicType = (ref.objectDataType as ClassDefinition).tsPolymorphicFieldType(refs)
                if (polymorphicType !== null)
                    return polymorphicType
            }
            refs.add(ref.objectDataType)
            return ref.objectDataType.name
        }
        val elem = ref.elementaryDataType
        if (elem === null)
            return "BonaPortable"
        if (elem.enumType !== null) {
            refs.add(elem.enumType)
            return elem.enumType.name
        }
        if (elem.xenumType !== null) {
            refs.add(elem.xenumType)
            return elem.xenumType.name
        }
        if (elem.enumsetType !== null) {
            refs.add(elem.enumsetType)
            return elem.enumsetType.name
        }
        if (elem.xenumsetType !== null) {
            refs.add(elem.xenumsetType)
            return elem.xenumsetType.name
        }
        switch (elem.name.toLowerCase) {
            case "boolean":
                "boolean"
            case "byte", case "short", case "int", case "integer", case "long",
            case "float", case "double", case "decimal", case "number", case "fixedpoint":
                "number"
            case "char", case "character", case "uuid", case "day",
            case "ascii", case "unicode", case "uppercase", case "lowercase",
            case "timestamp", case "time",
            case "raw", case "binary":
                "string"
            case "instant":
                "number"
            case "json":
                "Record<string, unknown>"
            case "array":
                "unknown[]"
            case "object", case "element":
                "BonaPortable"
            default:
                "BonaPortable"
        }
    }

    private static def String tsPolymorphicFieldType(ClassDefinition base, TsImportCollector refs) {
        if (!base.isAbstract || base.genericParameters.size > 0 || base.eResource.resourceSet === null)
            return null

        val descendants = new LinkedHashSet<ClassDefinition>
        for (resource : base.eResource.resourceSet.resources.filter[
            TsModuleResolver.isCurrentModule(it) || TsModuleResolver.isIncludedModule(it)
        ]) {
            for (candidate : resource.allContents.toIterable.filter(typeof(ClassDefinition))) {
                if (!candidate.isAbstract && candidate !== base && candidate.extendsType(base))
                    descendants.add(candidate)
            }
        }
        if (descendants.empty)
            return null

        val names = new LinkedHashSet<String>
        for (descendant : descendants) {
            refs.add(descendant)
            names.add(descendant.name)
        }
        return names.join(" | ")
    }

    private static def boolean extendsType(ClassDefinition candidate, ClassDefinition base) {
        var ClassDefinition current = candidate
        while (current.extendsClass !== null && current.extendsClass.classRef !== null) {
            current = current.extendsClass.classRef
            if (current === base)
                return true
        }
        return false
    }

    private static def String tsFieldClassRef(ClassReference ref, EObject from, TsImportCollector refs) {
        val classRef = ref.classRef
        if (classRef !== null && ref.classRefGenericParms.empty && classRef instanceof ClassDefinition) {
            val polymorphicType = (classRef as ClassDefinition).tsPolymorphicFieldType(refs)
            if (polymorphicType !== null)
                return polymorphicType
        }
        return ref.tsClassRef(from, refs)
    }
}
